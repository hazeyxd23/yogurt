DATABASE_URL=postgresql://postgres:postgres@localhost:5432/productivity_analytics

# Redis (caching)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=3600

# Celery (broker + result backend - typically a different Redis DB index than the cache)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email (SendGrid) - leave unset to run with email sending disabled
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@productivity-analytics.app

LOG_LEVEL=INFO
